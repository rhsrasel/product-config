{% liquid
  assign video_id = product.metafields.custom.vimeo_video_id
%}

{% if video_id != blank %}
  <div class="product-video isolate" {{ block.shopify_attributes }}>
    <iframe
      src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1{{ loop }}"
      class="js-vimeo"
      allow="autoplay; encrypted-media"
      frameborder="0"
      webkitAllowFullScreen
      mozallowfullscreen
      allowFullScreen
      title="Product video"
    ></iframe>
  </div>
{% endif %}

{%- stylesheet -%}
  .product-video {
    min-height: 240px;
  }

  .product-video iframe {
    width: 100%;
    height: 100%;
    min-height: inherit;
  }
{%- endstylesheet -%}
